VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Public VAPID key for the overtime-alert push notification (safe to expose
# client-side - it's the "public" half of the pair). Generate a pair with
# `npx web-push generate-vapid-keys`; the private half goes only into the
# send-overtime-alerts Edge Function's secrets, never here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
